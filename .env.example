# Copy to .env and fill in. Never commit .env.

# PostgreSQL container
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse

# App
DATABASE_URL=postgresql+psycopg://warehouse:change-me@localhost:5433/warehouse
# At least 32 random characters (the app refuses to start otherwise). Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Nightly low-stock job. Leave false here (tests and local runs).
# docker-compose.yml and the deployed app set it to true.
SCHEDULER_ENABLED=false

# Only true behind a proxy that adds X-Forwarded-For (Railway). Locally keep false,
# otherwise anyone could fake their IP to dodge the login rate limit.
TRUST_PROXY_HEADERS=false

# Public demo: shows demo logins on the login page and resets all data every night.
# NEVER turn this on for a real warehouse: the nightly reset deletes everything.
DEMO_MODE=false
